#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
image_dir=$(CDPATH= cd -- "${script_dir}/.." && pwd -P)

cd "${image_dir}"

remove_generated_hooks() {
  for hook_dir in config/hooks/live config/hooks/normal; do
    [ -d "${hook_dir}" ] || continue
    for hook_path in "${hook_dir}"/*; do
      [ -L "${hook_path}" ] || continue
      hook_target=$(readlink -- "${hook_path}")
      case "${hook_target}" in
        /usr/share/live/build/hooks/*)
          rm -f -- "${hook_path}"
          ;;
      esac
    done
  done
}

# Estes arquivos são gerados pelo lb config. Removê-los evita que opções antigas
# bloqueiem a aplicação coerente dos defaults derivados na próxima configuração.
remove_generated_hooks
rm -f \
  config/binary \
  config/bootstrap \
  config/chroot \
  config/common \
  config/source \
  config/package-lists/live.list.chroot

lb config noauto \
  --ignore-system-defaults \
  --mode debian \
  --distribution trixie \
  --architecture amd64 \
  --binary-image iso-hybrid \
  --system live \
  --initramfs live-boot \
  --initsystem systemd \
  --linux-flavours amd64 \
  --bootloaders "syslinux grub-efi" \
  --archive-areas "main" \
  --debian-installer none \
  --firmware-chroot false \
  --firmware-binary false \
  --uefi-secure-boot disable \
  --apt-recommends true \
  --security true \
  --updates true \
  --build-with-chroot true \
  --checksums sha256 \
  --memtest none \
  --source false \
  --win32-loader false \
  --zsync false \
  --utc-time true \
  --image-name flavos-3.0-m0 \
  --iso-application "Flavos OS 3.0 M0" \
  --iso-publisher "Flavos OS Project" \
  --iso-volume "FLAVOS_3_0_M0" \
  --bootappend-live "boot=live components hostname=flavos username=flavos systemd.unit=multi-user.target console=tty0 console=ttyS0,115200n8 flavos.m0.probe=1" \
  "$@"

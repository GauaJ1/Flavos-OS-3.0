[Unit]
Description=Validação automática do boot Flavos OS 3.0 M0
ConditionKernelCommandLine=flavos.m0.probe=1
Wants=getty@tty1.service serial-getty@ttyS0.service
After=multi-user.target live-config.service
After=getty@tty1.service serial-getty@ttyS0.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/flavos-m0-probe
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=20s
RemainAfterExit=yes

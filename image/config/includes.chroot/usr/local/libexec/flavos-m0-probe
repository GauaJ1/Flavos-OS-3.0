#!/bin/sh

set -u

result=PASS
failures=

add_failure() {
  result=FAIL
  if [ -z "${failures}" ]; then
    failures=$1
  else
    failures="${failures},$1"
  fi
}

pid1=$(cat /proc/1/comm 2>/dev/null || printf unknown)
architecture=$(uname -m 2>/dev/null || printf unknown)
kernel=$(uname -r 2>/dev/null || printf unknown)
hostname_value=$(cat /proc/sys/kernel/hostname 2>/dev/null || printf unknown)
multi_user=$(systemctl is-active multi-user.target 2>/dev/null || true)
tty1_state=$(systemctl is-active getty@tty1.service 2>/dev/null || true)
ttyS0_state=$(systemctl is-active serial-getty@ttyS0.service 2>/dev/null || true)

[ -n "${multi_user}" ] || multi_user=unknown
[ -n "${tty1_state}" ] || tty1_state=unknown
[ -n "${ttyS0_state}" ] || ttyS0_state=unknown

if [ -d /sys/firmware/efi ]; then
  firmware=uefi
else
  firmware=bios
fi

identity=ok
if ! grep -Fqx 'NAME="Flavos OS"' /etc/flavos-release 2>/dev/null || \
  ! grep -Fqx 'VERSION="3.0"' /etc/flavos-release 2>/dev/null || \
  ! grep -Fqx 'MILESTONE="M0"' /etc/flavos-release 2>/dev/null || \
  ! grep -Fqx 'ARCHITECTURE="amd64"' /etc/flavos-release 2>/dev/null; then
  identity=bad
  add_failure identity
fi

live_user=ok
if ! id flavos >/dev/null 2>&1; then
  live_user=bad
  add_failure live_user
fi

graphics=absent
if systemctl is-active --quiet display-manager.service 2>/dev/null; then
  graphics=active
  add_failure graphics
fi

graphical_target=$(systemctl is-active graphical.target 2>/dev/null || true)
[ -n "${graphical_target}" ] || graphical_target=unknown
if [ "${graphical_target}" = active ]; then
  graphics=active
  add_failure graphical_target
fi

for comm_file in /proc/[0-9]*/comm; do
  [ -r "${comm_file}" ] || continue
  IFS= read -r process_name <"${comm_file}" || process_name=
  case "${process_name}" in
    Xorg | Xwayland | weston | sway | cage | labwc | kwin_wayland | gnome-shell)
      graphics=active
      add_failure graphics_process
      break
      ;;
  esac
done

cmdline=ok
if ! grep -Eq '(^|[[:space:]])console=ttyS0,115200n8([[:space:]]|$)' \
  /proc/cmdline 2>/dev/null || \
  ! grep -Eq '(^|[[:space:]])flavos\.m0\.probe=1([[:space:]]|$)' \
  /proc/cmdline 2>/dev/null; then
  cmdline=bad
  add_failure cmdline
fi

[ "${pid1}" = systemd ] || add_failure pid1
[ "${architecture}" = x86_64 ] || add_failure architecture
[ "${hostname_value}" = flavos ] || add_failure hostname
[ "${multi_user}" = active ] || add_failure multi_user
[ "${tty1_state}" = active ] || add_failure tty1
[ "${ttyS0_state}" = active ] || add_failure ttyS0
[ -c /dev/tty1 ] || add_failure tty1_device
[ -c /dev/ttyS0 ] || add_failure ttyS0_device

[ -n "${failures}" ] || failures=none

printf '%s\n' \
  "FLAVOS_M0_PROBE result=${result} firmware=${firmware} kernel=${kernel} pid1=${pid1} arch=${architecture} hostname=${hostname_value} multi_user=${multi_user} tty1=${tty1_state} ttyS0=${ttyS0_state} identity=${identity} live_user=${live_user} graphics=${graphics} graphical_target=${graphical_target} cmdline=${cmdline} failures=${failures}"

[ "${result}" = PASS ]
